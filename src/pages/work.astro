---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getCategoriesWithWorks } from '../lib/db';

let categories: Awaited<ReturnType<typeof getCategoriesWithWorks>> = [];
try {
  categories = (await getCategoriesWithWorks()).filter((c) => c.works.length > 0);
} catch (err) {
  console.error('[work] failed to load categories:', err);
}
---

<Layout title="Work — Doofenshmirtz Evil Inc." description="Previous works from Doofenshmirtz Evil Inc., organized by category — builds, films, campaigns, and more.">
  <div class="page">
    <header class="page-hero">
      <span class="section-label" data-reveal>Artifact Vault</span>
      <h1 class="section-heading hero-heading">Our Work</h1>
      <p class="section-body" data-reveal style="max-width: 640px;">
        Browse what we've built, shot, and shipped — by craft. Pick a category to see everything inside it.
      </p>
    </header>

    {categories.length === 0 ? (
      <p class="works-status">No works published yet — check back soon.</p>
    ) : (
      <div class="work-grid">
        {categories.map((c) => (
          <a href={`/work/${c.slug}`} class="work-card category-card" data-reveal-scroll>
            <h2 class="work-title">{c.name}</h2>
            {c.description && <p class="work-desc">{c.description}</p>}
            <span class="work-link">View →</span>
          </a>
        ))}
      </div>
    )}

    <div class="page-cta">
      <p class="section-body">Want the full monolith in motion? It lives on the home page.</p>
      <a href="/" class="cta" data-magnetic>Back to the Monolith</a>
    </div>
  </div>
</Layout>

<script>
  import { initSite } from '../scripts/site';
  initSite();
</script>
