---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS } from '../data/products';
---

<Layout title="Work — Doofenshmirtz Evil Inc." description="Flagship artifacts from Doofenshmirtz Evil Inc. — content pipelines, animation, and explainers.">
  <div class="page">
    <header class="page-hero">
      <span class="section-label" data-reveal>Artifact Vault</span>
      <h1 class="section-heading hero-heading">Flagship Artifacts</h1>
      <p class="section-body" data-reveal style="max-width: 640px;">
        The pieces we keep behind glass — the work that defines how we build, shoot, and explain. Each one is a repeatable system, not a one-off.
      </p>
    </header>

    <div class="work-grid">
      {PRODUCTS.map((p, i) => (
        <article class="work-card" data-reveal-scroll>
          <span class="card-index">{String(i + 1).padStart(2, '0')} / {String(PRODUCTS.length).padStart(2, '0')}</span>
          <h2 class="work-title">{p.name}</h2>
          <p class="work-desc">{p.desc}</p>
          <a href="/contact" class="work-link" data-magnetic>Commission this →</a>
        </article>
      ))}
    </div>

    <div class="page-cta">
      <p class="section-body">Want the full monolith in motion? It lives on the home page.</p>
      <a href="/" class="cta" data-magnetic>Back to the Monolith</a>
    </div>
  </div>
</Layout>

<script>
  import { initSite } from '../scripts/site';
  initSite();
</script>
