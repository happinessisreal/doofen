---
import Layout from '../layouts/Layout.astro';
import { MonolithExperience } from '../components/MonolithExperience';
---

<Layout title="Doofenshmirtz Evil Inc. — The Digital Monolith">
  <MonolithExperience client:only="react" />

  <!-- Fixed background kinetic tagline -->
  <div class="fixed-tagline">
    <h1 id="kinetic-tagline">Techno-cultural Partner for Establishments</h1>
  </div>

  <!-- Scroll Container -->
  <div class="scroll-container">

    <!-- Hero / Monolith intro -->
    <section class="section-panel" id="about" style="height: 100vh; display: flex; align-items: flex-end; padding-bottom: 4rem;">
      <div class="section-content">
        <span class="section-label">Doofenshmirtz Evil Inc.</span>
        <h2 class="section-heading">Building the Digital Monolith</h2>
        <p class="section-body">
          A spatial, zero-gravity computational construct engineered for establishments seeking digital dominance across every channel and platform.
        </p>
        <span class="section-meta">Scroll to explore the tower</span>
      </div>
    </section>

    <!-- Services -->
    <section class="section-panel" id="services" style="height: 120vh; display: flex; align-items: center;">
      <div class="section-content right">
        <span class="section-label">What We Do</span>
        <h2 class="section-heading">15 Core Services</h2>
        <p class="section-body">
          From machine learning to political campaigns, our services orbit your goals in perfect synchronization. Hover the floating nodes to explore each one.
        </p>
        <div class="services-grid">
          <span>Website Building</span>
          <span>App Building</span>
          <span>Machine Learning</span>
          <span>SEO</span>
          <span>Digital Marketing</span>
          <span>Animation</span>
          <span>Content Creation</span>
          <span>Explainer</span>
          <span>Research</span>
          <span>Publication Consultancy</span>
          <span>Political Campaign</span>
          <span>Training Material</span>
          <span>Niche Tech</span>
          <span>Games</span>
          <span>Maintenance</span>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section class="section-panel" id="products" style="height: 120vh; display: flex; align-items: center;">
      <div class="section-content">
        <span class="section-label">Artifact Vault</span>
        <h2 class="section-heading">3 Core Products</h2>
        <p class="section-body">
          Our three flagship products float at the base of the tower. Click the 3D shapes to view detailed schematics for each.
        </p>
        <div class="services-grid" style="grid-template-columns: 1fr;">
          <span>Content Creation — Strategic multimedia pipelines</span>
          <span>Animation — Cinematic motion design at scale</span>
          <span>Explainer — Complex-to-clear video production</span>
        </div>
      </div>
    </section>

    <!-- About / Establishment -->
    <section class="about-section" id="establishment">
      <div class="about-col">
        <div>
          <h3 class="about-heading">The Blueprint</h3>
          <p class="about-text">
            Our mandate: merge techno-cultural design with unmatched administrative precision. By utilizing spatial technology we achieve unprecedented influence margins across the Tri-State area and beyond.
          </p>
        </div>
        <div class="about-meta-box">
          Sector: Tri-State Region<br />
          Founded: Danville, USA<br />
          Status: Actively Dominating
        </div>
      </div>

      <div class="about-col">
        <div>
          <h3 class="about-heading">Establishment Engagement</h3>
          <p class="about-text">
            Whether launching marketing offensives or commissioning complex training algorithms, Doofenshmirtz Evil Inc. handles the complete design and integration pipeline from concept to deployment.
          </p>
        </div>

        <div class="about-contact-grid">
          <div>
            <h4>Direct Line</h4>
            <p>director@doofenshmirtz-evil.inc</p>
          </div>
          <div>
            <h4>Headquarters</h4>
            <p>Doofenshmirtz Evil Inc. Building, Danville</p>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Camera scroll progress
  ScrollTrigger.create({
    trigger: '.scroll-container',
    start: 'top top',
    end: 'bottom bottom',
    scrub: 0.5,
    onUpdate: (self) => {
      (window as any).scrollProgress = self.progress;
    }
  });

  // Kinetic tagline parallax
  gsap.to('#kinetic-tagline', {
    scrollTrigger: {
      trigger: '.scroll-container',
      start: 'top top',
      end: 'bottom bottom',
      scrub: 0.5,
    },
    xPercent: -12,
    rotate: -1,
    opacity: 0.12
  });

  // Fade in section panels as they enter viewport
  document.querySelectorAll('.section-content').forEach((el) => {
    gsap.from(el, {
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
        toggleActions: 'play none none reverse',
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  });
</script>
