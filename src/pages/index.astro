---
import Layout from '../layouts/Layout.astro';
import { MonolithExperience } from '../components/MonolithExperience';
import { SERVICES } from '../data/services';

const featuredServices = SERVICES.slice(0, 6);
---

<Layout title="Doofenshmirtz Evil Inc. — The Digital Monolith">
  <!-- First-paint boot overlay. Rendered as static HTML so it covers the page
       immediately, before the client:only React island mounts (no FOUC). The
       Preloader component then drives its progress and dissolves it. -->
  <div class="preloader" id="preloader" role="status" aria-live="polite">
    <div class="preloader-inner">
      <span class="preloader-brand">Doofenshmirtz Evil Inc.</span>
      <span class="preloader-status"><span id="preloader-text">Initializing Monolith</span><span class="preloader-caret">▌</span></span>
      <div class="preloader-bar"><span class="preloader-bar-fill" id="preloader-bar"></span></div>
      <span class="preloader-pct" id="preloader-pct">000%</span>
    </div>
  </div>
  <script is:inline>
    // Safety net: never leave the site hidden if the 3D island fails to load.
    setTimeout(function () {
      var el = document.getElementById('preloader');
      if (el && !el.classList.contains('preloader--done')) {
        el.classList.add('preloader--done');
        setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 1000);
      }
    }, 9000);
  </script>

  <MonolithExperience client:only="react" />

  <!-- Scroll Container -->
  <div class="scroll-container">

    <!-- Hero -->
    <section class="section-panel" id="hero" style="height: 100vh; display: flex; align-items: flex-end; padding-bottom: 4rem;">
      <div class="section-content">
        <span class="section-label" data-reveal>Doofenshmirtz Evil Inc.</span>
        <h2 class="section-heading hero-heading">Techno-Cultural Partner for Your Establishments</h2>
        <p class="section-body" data-reveal>
          Dedicated to helping organizations innovate, communicate, and grow in the digital arena. By combining field data and insights, our technical experience, and creative solutions, we strategize for your establishments.
        </p>
        <div class="hero-cta-row" data-reveal>
          <a href="/contact" class="cta cta-primary" data-magnetic>Engage Us</a>
          <a href="/work" class="cta" data-magnetic>See our Work</a>
        </div>
        <div class="scroll-cue" data-reveal>
          <span class="scroll-cue-label">Scroll to explore</span>
          <span class="scroll-cue-track"><span class="scroll-cue-dot"></span></span>
        </div>
      </div>
    </section>

    <!-- Services teaser -->
    <section class="section-panel" id="services-teaser" style="height: 110vh; display: flex; align-items: center;">
      <div class="section-content right" data-reveal-scroll>
        <span class="section-label">What We Do</span>
        <h2 class="section-heading">From Code to Campaign</h2>
        <div class="services-grid">
          {featuredServices.map((s) => <span>{s.name}</span>)}
        </div>
        <a href="/services" class="cta" data-magnetic style="margin-top: 1.75rem;">All Services</a>
      </div>
    </section>

    <!-- Work teaser -->
    <section class="section-panel" id="work-teaser" style="height: 110vh; display: flex; align-items: center;">
      <div class="section-content" data-reveal-scroll>
        <span class="section-label">Selected Work</span>
        <h2 class="section-heading">From the Vault</h2>
        <ul class="vault-list" id="teaser-list">
          <li class="vault-empty">Loading…</li>
        </ul>
        <a href="/work" class="cta" data-magnetic style="margin-top: 1.75rem;">View Work</a>
      </div>
    </section>

    <!-- Contact band -->
    <section class="section-panel" id="contact-band" style="height: 90vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="section-content" style="max-width: 720px; margin: 0 auto; background: rgba(0,0,0,0.55);" data-reveal-scroll>
        <span class="section-label" style="display:block; text-align:center;">Engagement</span>
        <h2 class="section-heading" style="text-align:center;">Let's Build Something that no one thought before</h2>
        <p class="section-body" style="text-align:center;">
          Tell us what your establishment needs. We can summon the army of the dead for you
        </p>
        <div class="hero-cta-row" style="justify-content:center;">
          <a href="/contact" class="cta cta-primary" data-magnetic>Engage Us</a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initSite, initScrollCue } from '../scripts/site';

  gsap.registerPlugin(ScrollTrigger);

  // GSAP drives the scroll-linked 3D camera.
  ScrollTrigger.create({
    trigger: '.scroll-container',
    start: 'top top',
    end: 'bottom bottom',
    scrub: 0.5,
    onUpdate: (self) => {
      (window as any).scrollProgress = self.progress;
    },
  });

  // anime.js entrance + reveals + magnetic + progress bar (shared across pages).
  initSite();
  initScrollCue();

  // Populate the work teaser with live categories from the admin-managed data.
  (async () => {
    const list = document.getElementById('teaser-list');
    if (!list) return;
    try {
      const res = await fetch('/api/categories');
      const { categories } = await res.json() as {
        categories: { name: string; slug: string; description: string | null; works: unknown[] }[];
      };
      const withWorks = categories.filter((c) => c.works.length > 0);
      if (withWorks.length === 0) {
        list.innerHTML = '<li class="vault-empty">Work is being catalogued — view the vault soon.</li>';
        return;
      }
      list.innerHTML = withWorks.slice(0, 5).map((c, i) => `
        <li class="vault-item">
          <a class="vault-link" href="/work/${c.slug}">
            <span class="vault-index">${String(i + 1).padStart(2, '0')}</span>
            <span class="vault-text">
              <span class="vault-name">${c.name}</span>
              <span class="vault-desc">${c.description ?? `${c.works.length} piece${c.works.length === 1 ? '' : 's'}`}</span>
            </span>
          </a>
        </li>`).join('');
    } catch {
      list.innerHTML = '<li class="vault-empty">Work is being catalogued — view the vault soon.</li>';
    }
  })();
</script>
