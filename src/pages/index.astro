---
import Layout from '../layouts/Layout.astro';
import { MonolithExperience } from '../components/MonolithExperience';
import { SERVICES } from '../data/services';
import { PRODUCTS } from '../data/products';

const featuredServices = SERVICES.slice(0, 6);

// Card list for the work teaser — the 3D artifacts plus Digital Marketing.
const flagship = [
  ...PRODUCTS.map(({ name, desc }) => ({ name, desc })),
  { name: 'Digital Marketing', desc: 'Full-funnel marketing campaigns across digital channels.' },
];
---

<Layout title="Doofenshmirtz Evil Inc. — The Digital Monolith">
  <MonolithExperience client:only="react" />

  <!-- Scroll Container -->
  <div class="scroll-container">

    <!-- Hero -->
    <section class="section-panel" id="hero" style="height: 100vh; display: flex; align-items: flex-end; padding-bottom: 4rem;">
      <div class="section-content">
        <span class="section-label" data-reveal>Doofenshmirtz Evil Inc.</span>
        <h2 class="section-heading hero-heading">Techno-Cultural Partner for Establishments</h2>
        <p class="section-body" data-reveal>
          Part laboratory, part design studio. We engineer the digital machinery establishments use to take over their corner of the world — websites, campaigns, films, and the strange custom tech in between, built with precision and an unreasonable amount of taste.
        </p>
        <div class="hero-cta-row" data-reveal>
          <a href="/contact" class="cta cta-primary" data-magnetic>Engage Us</a>
          <a href="/work" class="cta" data-magnetic>See the Work</a>
        </div>
        <div class="scroll-cue" data-reveal>
          <span class="scroll-cue-label">Scroll to explore</span>
          <span class="scroll-cue-track"><span class="scroll-cue-dot"></span></span>
        </div>
      </div>
    </section>

    <!-- Services teaser -->
    <section class="section-panel" id="services-teaser" style="height: 110vh; display: flex; align-items: center;">
      <div class="section-content right" data-reveal-scroll>
        <span class="section-label">What We Do</span>
        <h2 class="section-heading">From Code to Campaign</h2>
        <p class="section-body">
          Machine learning, marketing, films, full product builds, the occasional political campaign — if it lives on a screen or moves a crowd, we make it.
        </p>
        <div class="services-grid">
          {featuredServices.map((s) => <span>{s.name}</span>)}
        </div>
        <a href="/services" class="cta" data-magnetic style="margin-top: 1.75rem;">All Services</a>
      </div>
    </section>

    <!-- Work teaser -->
    <section class="section-panel" id="work-teaser" style="height: 110vh; display: flex; align-items: center;">
      <div class="section-content" data-reveal-scroll>
        <ul class="vault-list">
          {flagship.map((p, i) => (
            <li class="vault-item">
              <span class="vault-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="vault-text">
                <span class="vault-name">{p.name}</span>
                <span class="vault-desc">{p.desc}</span>
              </span>
            </li>
          ))}
        </ul>
        <a href="/work" class="cta" data-magnetic style="margin-top: 1.75rem;">View Work</a>
      </div>
    </section>

    <!-- Contact band -->
    <section class="section-panel" id="contact-band" style="height: 90vh; display: flex; align-items: center; justify-content: center; text-align: center;">
      <div class="section-content" style="max-width: 720px; margin: 0 auto; background: rgba(0,0,0,0.55);" data-reveal-scroll>
        <span class="section-label" style="display:block; text-align:center;">Engagement</span>
        <h2 class="section-heading" style="text-align:center;">Let's Build Something Unreasonable</h2>
        <p class="section-body" style="text-align:center;">
          Tell us what your establishment is trying to become. We'll bring the machinery.
        </p>
        <div class="hero-cta-row" style="justify-content:center;">
          <a href="/contact" class="cta cta-primary" data-magnetic>Engage Us</a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initSite, initScrollCue } from '../scripts/site';

  gsap.registerPlugin(ScrollTrigger);

  // GSAP drives the scroll-linked 3D camera.
  ScrollTrigger.create({
    trigger: '.scroll-container',
    start: 'top top',
    end: 'bottom bottom',
    scrub: 0.5,
    onUpdate: (self) => {
      (window as any).scrollProgress = self.progress;
    },
  });

  // anime.js entrance + reveals + magnetic + progress bar (shared across pages).
  initSite();
  initScrollCue();
</script>
