---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Doofenshmirtz Evil Inc. — Techno-cultural partner for establishments. Edge-ready digital solutions and spatial installations."
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/who-we-are', label: 'Who We Are' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Mark JS as active so anime.js reveal states apply (prevents flash-of-content) -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress"></div>
    <div class="grid-bg"></div>
    <div class="hero-glow"></div>
    <div class="noise-overlay"></div>

    <!-- Minimal top bar -->
    <header class="site-header" id="main-header">
      <a href="/" class="header-left" aria-label="Doofenshmirtz Evil Inc. — Home">
        <span class="header-logo" data-reveal>DE</span>
        <span class="header-brand" data-reveal>Doofenshmirtz Evil Inc.</span>
      </a>
      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav class="header-nav-links" id="primary-nav" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
            data-reveal
          >{item.label}</a>
        ))}
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col">
          <span class="footer-label">Doofenshmirtz Evil Inc.</span>
          <span class="footer-sub">Techno-cultural Partner for Establishments</span>
        </div>
        <nav class="footer-nav" aria-label="Footer Navigation">
          {navItems.map((item) => (
            <a href={item.href} class="footer-link">{item.label}</a>
          ))}
        </nav>
        <div class="footer-col footer-col-right">
          <span class="footer-label">Get in Touch</span>
          <span class="footer-sub">director@doofenshmirtz-evil.inc</span>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {year} Doofenshmirtz Evil Inc. All rights reserved.</span>
      </div>
    </footer>

    <!-- Mobile nav: hamburger toggles a full-screen slide-in menu -->
    <script is:inline>
      (function () {
        var header = document.getElementById('main-header');
        var toggle = document.getElementById('nav-toggle');
        var nav = document.getElementById('primary-nav');
        if (!header || !toggle || !nav) return;
        function setOpen(open) {
          header.classList.toggle('nav-open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.body.style.overflow = open ? 'hidden' : '';
        }
        toggle.addEventListener('click', function () {
          setOpen(!header.classList.contains('nav-open'));
        });
        nav.addEventListener('click', function (e) {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') setOpen(false);
        });
        window.addEventListener('resize', function () {
          if (window.innerWidth > 768) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
